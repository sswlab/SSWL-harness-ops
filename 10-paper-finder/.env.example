# 대안: .env 파일 방식.
# 이 파일을 '.env'로 복사한 뒤 토큰을 채우고, 셸에서 `set -a; source .env; set +a` 로 로드.
# settings.local.json 방식을 쓴다면 이 파일은 필요 없습니다.

# Semantic Scholar (선택 — 없어도 무인증으로 동작하지만 rate limit 낮음)
S2_API_KEY=

# NASA ADS (천체물리 도메인 핵심. https://ui.adsabs.harvard.edu/user/settings/token 에서 발급)
ADS_API_TOKEN=

# ADS API base URL (변경 필요 없으면 기본값 사용)
ADS_API_BASE=https://api.adsabs.harvard.edu/v1
